{
  "name": "atlas-memoria",
  "private": true,
  "version": "2.3.0",
  "description": "Atlas interactivo de tu memoria: vaults de Obsidian con un vault central, skills y agentes de Claude Code, Codex y Antigravity. Lo instala una IA en cualquier equipo.",
  "repository": {
    "type": "git",
    "url": "https://github.com/anndreloopez012/atlas-memoria.git"
  },
  "type": "module",
  "scripts": {
    "instalar": "node scripts/instalar.mjs",
    "detectar": "node scripts/instalar.mjs --solo-detectar",
    "verificar": "node scripts/verificar.mjs",
    "datos": "node scripts/generar-datos.mjs",
    "traducir": "node scripts/traducir.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "start": "vite build && vite preview",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lanzador": "node scripts/lanzador.mjs",
    "abrir": "node scripts/abrir.mjs",
    "actualizar": "node scripts/actualizar.mjs",
    "desinstalar": "node scripts/desinstalar.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "d3-hierarchy": "^3.1.2",
    "dompurify": "^3.4.16",
    "force-graph": "^1.52.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.50.0",
    "marked": "^18.0.14",
    "minisearch": "^7.2.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
